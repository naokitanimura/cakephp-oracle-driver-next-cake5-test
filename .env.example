# SYS / SYSTEM / PDBADMIN password for the Oracle container.
ORACLE_PWD=OraclePass123

# Application schema user, created automatically on first boot by
# docker/oracle/setup/01_create_user.sql. Must match that file's values
# if you change either side.
DB_SERVICE=FREEPDB1
DB_USERNAME=testuser
DB_PASSWORD=TestUserPass123
