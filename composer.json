{
    "name": "cakedc/cakephp-oracle-driver-crud-test",
    "description": "Real Oracle Database CRUD test project for CakeDC/cakephp-oracle-driver (6.next-cake5)",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/CakeDC/cakephp-oracle-driver"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-pdo": "*",
        "cakephp/cakephp": "^5.3",
        "cakedc/cakephp-oracle-driver": "dev-6.next-cake5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 | ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
