{
    "name": "cakedc/cakephp-oracle-driver-crud-test",
    "description": "Real Oracle Database CRUD test project for ioigoume/cakephp5-oracle-driver",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-pdo": "*",
        "cakephp/cakephp": "^5.4",
        "ioigoume/cakephp5-oracle-driver": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 | ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
